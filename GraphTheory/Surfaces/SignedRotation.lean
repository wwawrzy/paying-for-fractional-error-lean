import GraphTheory.SimpleGraph.Planar.RotationSystem
import Mathlib.Logic.Relation

/-! Signed local rotations allow orientable and nonorientable embeddings.
The four flags of an edge carry the three fixed-point-free involutions used
in combinatorial surface maps. Vertex and face classes are generated by
the corresponding pairs of involutions. No density or minor-closure property
is included in the data.

Reference: Kociumaka and Pilipczuk, Algorithmica 81 (2019), Section 3.1,
https://doi.org/10.1007/s00453-019-00592-7.
-/

namespace SimpleGraph

variable {V : Type*} (G : SimpleGraph V)

structure SignedRotation extends RotationSystem G where
  cyclic : ∀ d e : G.Dart, d.toProd.1 = e.toProd.1 → σ.SameCycle d e
  /-- True reverses the local surface orientation along an edge. -/
  twist : G.Dart → Bool
  twist_symm : ∀ d, twist d.symm = twist d

namespace SignedRotation

abbrev Flag := G.Dart × Bool

variable {G} (r : SignedRotation G)

def edgeFlip (x : Flag G) : Flag G :=
  (x.1.symm, if r.twist x.1 then x.2 else !x.2)

def sideFlip (x : Flag G) : Flag G := (x.1, !x.2)

def cornerFlip (x : Flag G) : Flag G :=
  if x.2 then (r.σ.symm x.1, false) else (r.σ x.1, true)

theorem edgeFlip_involutive : Function.Involutive r.edgeFlip := by
  intro x
  rcases x with ⟨d, b⟩
  simp only [edgeFlip, r.twist_symm, Dart.symm_symm]
  cases r.twist d <;> cases b <;> rfl

theorem sideFlip_involutive : Function.Involutive (sideFlip (G := G)) := by
  rintro ⟨d, b⟩
  cases b <;> rfl

theorem cornerFlip_involutive : Function.Involutive r.cornerFlip := by
  rintro ⟨d, b⟩
  cases b <;> simp [cornerFlip]

theorem edgeFlip_ne_self (x : Flag G) : r.edgeFlip x ≠ x := by
  intro h
  exact x.1.symm_ne (congrArg Prod.fst h)

theorem sideFlip_ne_self (x : Flag G) : sideFlip x ≠ x := by
  rintro h
  have hb := congrArg Prod.snd h
  cases x.2 <;> simp [sideFlip] at hb

theorem cornerFlip_ne_self (x : Flag G) : r.cornerFlip x ≠ x := by
  rintro h
  have hb := congrArg Prod.snd h
  cases hbit : x.2 <;> simp [cornerFlip, hbit] at hb

theorem edgeFlip_sideFlip (x : Flag G) :
    r.edgeFlip (sideFlip x) = sideFlip (r.edgeFlip x) := by
  rcases x with ⟨d, b⟩
  cases h : r.twist d <;> cases b <;> simp [edgeFlip, sideFlip, h]

theorem edgeFlip_ne_sideFlip (x : Flag G) : r.edgeFlip x ≠ sideFlip x := by
  intro h
  exact x.1.symm_ne (congrArg Prod.fst h)

theorem cornerFlip_source (x : Flag G) :
    (r.cornerFlip x).1.toProd.1 = x.1.toProd.1 := by
  have hi : (r.σ.symm x.1).toProd.1 = x.1.toProd.1 := by
    have h := r.σ_source (r.σ.symm x.1)
    simpa using h.symm
  cases hbit : x.2 <;> simp [cornerFlip, hbit, r.σ_source, hi]

/-- Equivalence classes generated by two flag involutions. -/
def pairSetoid (f g : Flag G → Flag G) : Setoid (Flag G) :=
  Relation.EqvGen.setoid (fun x y => f x = y ∨ g x = y)

def Vertex := Quotient (pairSetoid (sideFlip (G := G)) r.cornerFlip)
def Edge := Quotient (pairSetoid r.edgeFlip (sideFlip (G := G)))
def Face := Quotient (pairSetoid r.edgeFlip r.cornerFlip)
def Component := Quotient (Relation.EqvGen.setoid
  (fun x y : Flag G => r.edgeFlip x = y ∨ sideFlip x = y ∨ r.cornerFlip x = y))

/-- Isolated graph vertices have no flags and are omitted from these counts.
Euler characteristic and genus use integer arithmetic, without truncation. -/
noncomputable def eulerCharacteristic : ℤ :=
  (Nat.card r.Vertex : ℤ) - (Nat.card r.Edge : ℤ) + (Nat.card r.Face : ℤ)

noncomputable def eulerGenus : ℤ :=
  2 * (Nat.card r.Component : ℤ) - r.eulerCharacteristic

theorem flag_card [Fintype V] [DecidableEq V] [DecidableRel G.Adj] :
    Fintype.card (Flag G) = 4 * G.edgeFinset.card := by
  rw [Fintype.card_prod, G.dart_card_eq_twice_card_edges]
  simp only [Fintype.card_bool]
  omega

end SignedRotation
end SimpleGraph

#print axioms SimpleGraph.SignedRotation.edgeFlip_involutive
#print axioms SimpleGraph.SignedRotation.cornerFlip_involutive
#print axioms SimpleGraph.SignedRotation.edgeFlip_sideFlip
#print axioms SimpleGraph.SignedRotation.flag_card
