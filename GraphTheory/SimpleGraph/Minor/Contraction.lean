import GraphTheory.SimpleGraph.Minor.Defs

/-!
# Edge Contraction for Simple Graphs

Definition of edge contraction via quotient types, following Diestel 1.4.

Given a simple graph `G` on vertex type `V` and an edge `{u, v}`, the contraction
`G / {u,v}` identifies `u` and `v` into a single vertex and removes any resulting
loops. We model this as a `SimpleGraph` on the quotient type `V / ~` where `~` is
the equivalence relation generated by `u ~ v`.

## Main definitions

* `SimpleGraph.EdgeContraction.contrSetoid` -- equivalence relation merging u and v
* `SimpleGraph.EdgeContraction.ContrVertex` -- the quotient type
* `SimpleGraph.EdgeContraction.contrGraph` -- the contracted graph

## Main results

* `contrGraph_adj_iff` -- adjacency characterization in the contracted graph
* `contrMk_eq` -- u and v map to the same class
* `contrVertex_card` -- |V(G/e)| = |V(G)| - 1
* `contrEdgeFinset_card_le` -- |E(G/e)| <= |E(G)| - 1
-/

namespace SimpleGraph

namespace EdgeContraction

universe u

variable {V : Type u}

/-- The base relation that pairs `u` with `v` (symmetrically). -/
def PairRel (u v : V) (a b : V) : Prop :=
  Or (And (a = u) (b = v)) (And (a = v) (b = u))

/-- The `Setoid` instance that identifies `u` and `v` via `Relation.EqvGen`. -/
def contrSetoid (u v : V) : Setoid V :=
  Relation.EqvGen.setoid (PairRel u v)

/-- The quotient vertex type after contracting the edge `{u, v}`. -/
abbrev ContrVertex (u v : V) : Type u :=
  Quotient (contrSetoid u v)

noncomputable instance instFintypeContrVertex [Fintype V] [DecidableEq V]
    (u v : V) : Fintype (ContrVertex u v) := by
  classical
  exact Quotient.fintype (contrSetoid u v)

/-- The quotient map. -/
def contrMk (u v : V) (w : V) : ContrVertex u v :=
  Quotient.mk (contrSetoid u v) w

/-- `u` and `v` are identified in the quotient. -/
theorem contrMk_eq (u v : V) : contrMk u v u = contrMk u v v := by
  unfold contrMk; apply Quotient.sound
  exact Relation.EqvGen.rel _ _ (Or.inl (And.intro rfl rfl))

/-- Every element related to `a` via `EqvGen (PairRel u v)` is either `a`, `u`, or `v`. -/
private theorem eqvGen_pairRel_trichotomy (u v : V) {a b : V}
    (h : Relation.EqvGen (PairRel u v) a b) : b = a ∨ (a = u ∧ b = v) ∨ (a = v ∧ b = u) ∨
    (a = u ∧ b = u) ∨ (a = v ∧ b = v) := by
  induction h with
  | rel x y hxy =>
    unfold PairRel at hxy
    rcases hxy with ⟨rfl, rfl⟩ | ⟨rfl, rfl⟩
    · exact Or.inr (Or.inl ⟨rfl, rfl⟩)
    · exact Or.inr (Or.inr (Or.inl ⟨rfl, rfl⟩))
  | refl => exact Or.inl rfl
  | symm x y _ ih =>
    rcases ih with rfl | ⟨rfl, rfl⟩ | ⟨rfl, rfl⟩ | ⟨rfl, rfl⟩ | ⟨rfl, rfl⟩
    · exact Or.inl rfl
    · exact Or.inr (Or.inr (Or.inl ⟨rfl, rfl⟩))
    · exact Or.inr (Or.inl ⟨rfl, rfl⟩)
    · exact Or.inr (Or.inr (Or.inr (Or.inl ⟨rfl, rfl⟩)))
    · exact Or.inr (Or.inr (Or.inr (Or.inr ⟨rfl, rfl⟩)))
  | trans x y z _ _ ih1 ih2 =>
    rcases ih1 with rfl | ⟨rfl, rfl⟩ | ⟨rfl, rfl⟩ | ⟨rfl, rfl⟩ | ⟨rfl, rfl⟩
    · exact ih2
    all_goals (rcases ih2 with rfl | ⟨h1, h2⟩ | ⟨h1, h2⟩ | ⟨h1, h2⟩ | ⟨h1, h2⟩ <;> simp_all)

/-- If `a ∉ {u, v}` and `EqvGen (PairRel u v) a b`, then `a = b`. -/
private theorem eqvGen_pairRel_eq (u v : V) {a b : V}
    (hau : a ≠ u) (hav : a ≠ v) (h : Relation.EqvGen (PairRel u v) a b) : a = b := by
  rcases eqvGen_pairRel_trichotomy u v h with rfl | ⟨rfl, _⟩ | ⟨rfl, _⟩ | ⟨rfl, _⟩ | ⟨rfl, _⟩
  · rfl
  · exact absurd rfl hau
  · exact absurd rfl hav
  · exact absurd rfl hau
  · exact absurd rfl hav

/-- For `w` not in `{u, v}` and `w'` not in `{u, v}`, equal images implies equal vertices. -/
theorem contrMk_injective (u v : V) {w w' : V}
    (hwu : Ne w u) (hwv : Ne w v) (hw'u : Ne w' u) (hw'v : Ne w' v)
    (heq : contrMk u v w = contrMk u v w') : w = w' := by
  have h : (contrSetoid u v).r w w' := Quotient.exact heq
  change Relation.EqvGen (PairRel u v) w w' at h
  exact eqvGen_pairRel_eq u v hwu hwv h

/-! ### The contracted graph -/

/-- The contracted graph: a `SimpleGraph` on the quotient type.
    Two classes `x` and `y` are adjacent iff they are distinct and there exist
    representatives `a` in `x`, `b` in `y` with `G.Adj a b`. -/
noncomputable def contrGraph [DecidableEq V] (G : SimpleGraph V) (u v : V) :
    SimpleGraph (ContrVertex u v) where
  Adj x y :=
    x ≠ y ∧ ∃ a b, contrMk u v a = x ∧ contrMk u v b = y ∧ G.Adj a b
  symm x y h := by
    obtain ⟨hne, a, b, ha, hb, hadj⟩ := h
    exact ⟨hne.symm, b, a, hb, ha, hadj.symm⟩
  loopless := ⟨fun x ⟨hne, _⟩ => hne rfl⟩

/-! ### Characterizing EqvGen and equality of quotient classes -/

/-- Full characterization: `EqvGen (PairRel u v) a b` holds exactly when
`a = b`, or `a = u` and `b = v`, or `a = v` and `b = u`. -/
theorem eqvGen_pairRel_iff (u v : V) (a b : V) :
    Relation.EqvGen (PairRel u v) a b ↔
      a = b ∨ (a = u ∧ b = v) ∨ (a = v ∧ b = u) := by
  constructor
  · intro h
    rcases eqvGen_pairRel_trichotomy u v h with rfl | ⟨rfl, rfl⟩ | ⟨rfl, rfl⟩ |
        ⟨rfl, rfl⟩ | ⟨rfl, rfl⟩
    · exact Or.inl rfl
    · exact Or.inr (Or.inl ⟨rfl, rfl⟩)
    · exact Or.inr (Or.inr ⟨rfl, rfl⟩)
    · exact Or.inl rfl
    · exact Or.inl rfl
  · intro h
    rcases h with rfl | ⟨rfl, rfl⟩ | ⟨rfl, rfl⟩
    · exact Relation.EqvGen.refl _
    · exact Relation.EqvGen.rel _ _ (Or.inl ⟨rfl, rfl⟩)
    · exact Relation.EqvGen.rel _ _ (Or.inr ⟨rfl, rfl⟩)

/-- Classes `[a]` and `[b]` in `G/{u,v}` are equal exactly when the vertices
are equal or are the two endpoints being identified. -/
theorem contrMk_eq_iff (u v : V) (a b : V) :
    contrMk u v a = contrMk u v b ↔
      a = b ∨ (a = u ∧ b = v) ∨ (a = v ∧ b = u) := by
  unfold contrMk
  rw [Quotient.eq]
  exact eqvGen_pairRel_iff u v a b

/-- `[a] = [u]` in `G/{u,v}` exactly when `a = u` or `a = v`. -/
theorem contrMk_eq_u_iff (u v : V) (a : V) :
    contrMk u v a = contrMk u v u ↔ a = u ∨ a = v := by
  rw [contrMk_eq_iff]
  constructor
  · rintro (rfl | ⟨rfl, _⟩ | ⟨rfl, _⟩)
    · exact Or.inl rfl
    · exact Or.inl rfl
    · exact Or.inr rfl
  · rintro (rfl | rfl)
    · exact Or.inl rfl
    · exact Or.inr (Or.inr ⟨rfl, rfl⟩)

/-- The quotient map is surjective. -/
theorem contrMk_surjective (u v : V) : Function.Surjective (contrMk u v) := by
  intro x
  unfold contrMk
  exact Quotient.exists_rep x

/-! ### Adjacency in the contracted graph -/

/-- **Adjacency in `G/{u,v}`.** Classes `[a]` and `[b]` are adjacent exactly
when they are distinct and some representatives are adjacent in `G`. -/
theorem contrGraph_adj_iff [DecidableEq V] (G : SimpleGraph V) (u v : V) (a b : V) :
    (contrGraph G u v).Adj (contrMk u v a) (contrMk u v b) ↔
      contrMk u v a ≠ contrMk u v b ∧
      ∃ a' b', contrMk u v a' = contrMk u v a ∧ contrMk u v b' = contrMk u v b ∧
        G.Adj a' b' := by
  rfl

/-- An edge of `G` whose endpoint classes differ gives an edge in `G/{u,v}`. -/
theorem contrGraph_adj_of_adj [DecidableEq V] (G : SimpleGraph V) (u v : V)
    {a b : V} (hadj : G.Adj a b) (hne : contrMk u v a ≠ contrMk u v b) :
    (contrGraph G u v).Adj (contrMk u v a) (contrMk u v b) :=
  ⟨hne, a, b, rfl, rfl, hadj⟩

/-- Every edge of `G/{u,v}` comes from an edge of `G`. -/
theorem contrGraph_adj_imp_exists [DecidableEq V] (G : SimpleGraph V) (u v : V)
    {x y : ContrVertex u v} (hxy : (contrGraph G u v).Adj x y) :
    ∃ a b, contrMk u v a = x ∧ contrMk u v b = y ∧ G.Adj a b :=
  hxy.2

/-! ### Vertex count after contraction

The exact count `|V/{u,v}| = |V| - 1` for distinct endpoints, and a general bound. -/

/-- Surjectivity of `V → ContrVertex u v` gives `|V/{u,v}| ≤ |V|`. -/
theorem contrVertex_card_le [Fintype V] [DecidableEq V] (u v : V) :
    Fintype.card (ContrVertex u v) ≤ Fintype.card V := by
  classical
  exact Fintype.card_le_of_surjective (contrMk u v) (contrMk_surjective u v)

/-- If `u ≠ v`, identifying their classes strictly decreases the vertex count. -/
theorem contrVertex_card_lt [Fintype V] [DecidableEq V] {u v : V} (huv : u ≠ v) :
    Fintype.card (ContrVertex u v) < Fintype.card V := by
  classical
  -- contrMk u v is not injective: u ≠ v but [u] = [v].
  have hnotInj : ¬ Function.Injective (contrMk u v) := by
    intro hinj
    exact huv (hinj (contrMk_eq u v))
  -- A noninjective surjection between finite sets has a smaller codomain.
  by_contra hge
  push_neg at hge
  have hle := contrVertex_card_le (V := V) u v
  have heq : Fintype.card (ContrVertex u v) = Fintype.card V :=
    le_antisymm hle hge
  -- A surjection between finite sets of equal cardinality is injective.
  have hbij : Function.Bijective (contrMk u v) :=
    (Fintype.bijective_iff_surjective_and_card _).mpr
      ⟨contrMk_surjective u v, heq.symm⟩
  exact hnotInj hbij.1

/-! ### Fibers of the quotient map

The fiber over `[u]` is `{u, v}`; for `w ∉ {u, v}`, the fiber over `[w]`
is the singleton `{w}`. -/

/-- The fiber over `[u]`: if `[w] = [u]`, then `w ∈ {u, v}`. -/
theorem contrMk_preimage_u_iff (u v : V) (w : V) :
    contrMk u v w = contrMk u v u ↔ w = u ∨ w = v :=
  contrMk_eq_u_iff u v w

/-- The fiber over `[v]` agrees with the fiber over `[u]`, since `[u] = [v]`. -/
theorem contrMk_preimage_v_iff (u v : V) (w : V) :
    contrMk u v w = contrMk u v v ↔ w = u ∨ w = v := by
  rw [← contrMk_eq u v]
  exact contrMk_eq_u_iff u v w

/-- Singleton fibers: if `w ∉ {u, v}` and `[w'] = [w]`, then `w' = w`. -/
theorem contrMk_preimage_singleton (u v : V) {w : V} (hu : w ≠ u) (hv : w ≠ v)
    (w' : V) :
    contrMk u v w' = contrMk u v w ↔ w' = w := by
  rw [contrMk_eq_iff]
  constructor
  · rintro (h | ⟨_, hv'⟩ | ⟨_, hu'⟩)
    · exact h
    · exact absurd hv' hv
    · exact absurd hu' hu
  · rintro rfl; exact Or.inl rfl

/-! ### Exact vertex count after contraction -/

/-- Restricting `contrMk u v` to `V \ {v}` is injective: each class has at most
one representative other than `v`. -/
theorem contrMk_injOn_compl_v (u v : V) :
    Set.InjOn (contrMk u v) {w | w ≠ v} := by
  intro a ha b hb hab
  simp only [Set.mem_setOf_eq] at ha hb
  rw [contrMk_eq_iff] at hab
  rcases hab with h | ⟨_, hbv⟩ | ⟨hav, _⟩
  · exact h
  · exact absurd hbv hb
  · exact absurd hav ha

/-- For `u ≠ v`, restricting `contrMk u v` to `V \ {v}` is surjective.
When a representative is `v`, replace it with `u`, which has the same class. -/
theorem contrMk_surjOn_compl_v (u v : V) (huv : u ≠ v) :
    Set.SurjOn (contrMk u v) {w | w ≠ v} Set.univ := by
  intro x _
  obtain ⟨a, ha⟩ := contrMk_surjective u v x
  by_cases hav : a = v
  · -- If a = v, use u, since [u] = [v] = x.
    refine ⟨u, ?_, ?_⟩
    · simp [huv]
    · subst hav; rw [contrMk_eq]; exact ha
  · refine ⟨a, ?_, ha⟩
    simp [hav]

/-- The quotient map is a bijection from `{w : V | w ≠ v}` to `ContrVertex u v`.
Distinctness of `u` and `v` allows `u` to represent the class of `v`. -/
theorem contrMk_bijOn_compl_v (u v : V) (huv : u ≠ v) :
    Set.BijOn (contrMk u v) {w | w ≠ v} Set.univ :=
  ⟨fun w _ => Set.mem_univ _, contrMk_injOn_compl_v u v, contrMk_surjOn_compl_v u v huv⟩

/-- **Exact vertex count:** `|V/{u,v}| = |V| - 1` when `u ≠ v`. -/
theorem contrVertex_card_eq [Fintype V] [DecidableEq V] {u v : V} (huv : u ≠ v) :
    Fintype.card (ContrVertex u v) = Fintype.card V - 1 := by
  classical
  -- Use the bijection with {w : V | w ≠ v}.
  have hbij := contrMk_bijOn_compl_v u v huv
  -- The complement of one vertex has cardinality |V| - 1.
  have hcompl : ({w : V | w ≠ v}).ncard = Fintype.card V - 1 := by
    have h1 : ({w : V | w ≠ v} : Set V) = (Set.univ : Set V) \ {v} := by
      ext w; simp
    rw [h1, Set.ncard_diff (by simp) (Set.toFinite _),
        Set.ncard_univ, Set.ncard_singleton, Nat.card_eq_fintype_card]
  -- A bijection preserves ncard.
  have h2 : (Set.univ : Set (ContrVertex u v)).ncard = ({w : V | w ≠ v}).ncard :=
    (hbij.ncard_eq).symm
  rw [Set.ncard_univ, Nat.card_eq_fintype_card] at h2
  rw [h2, hcompl]

/-! ### Reachability and preservation of connectedness -/

/-- An edge in `G` maps to a reachability step in the contracted graph,
including the case where both endpoint classes coincide. -/
theorem contrGraph_reachable_of_adj [DecidableEq V] (G : SimpleGraph V) (u v : V)
    {a b : V} (hadj : G.Adj a b) :
    (contrGraph G u v).Reachable (contrMk u v a) (contrMk u v b) := by
  classical
  by_cases hne : contrMk u v a = contrMk u v b
  · rw [hne]
  · exact (contrGraph_adj_of_adj G u v hadj hne).reachable

/-- A walk in `G` maps to reachability in `G/{u,v}`. -/
theorem contrGraph_reachable_of_walk [DecidableEq V] (G : SimpleGraph V) (u v : V)
    {a b : V} (p : G.Walk a b) :
    (contrGraph G u v).Reachable (contrMk u v a) (contrMk u v b) := by
  classical
  induction p with
  | nil => exact Reachable.refl _
  | cons hadj _ ih =>
    exact (contrGraph_reachable_of_adj G u v hadj).trans ih

/-- **Contraction preserves connectedness:** if `G` is connected, so is `G/{u,v}`. -/
theorem contrGraph_connected [DecidableEq V] (G : SimpleGraph V) {u v : V}
    (hG : G.Connected) :
    (contrGraph G u v).Connected := by
  classical
  haveI : Nonempty (ContrVertex u v) := by
    obtain ⟨w⟩ := hG.nonempty
    exact ⟨contrMk u v w⟩
  refine Connected.mk ?_
  intro x y
  obtain ⟨a, rfl⟩ := contrMk_surjective u v x
  obtain ⟨b, rfl⟩ := contrMk_surjective u v y
  obtain ⟨p⟩ := hG.preconnected a b
  exact contrGraph_reachable_of_walk G u v p

/-! ### A contraction is a minor operation -/

/-- Contracting an actual edge of `G` produces a minor of `G`.

The branch set of a quotient vertex is the corresponding fibre of `contrMk`.
Every fibre is a singleton except the contracted class, whose two vertices are
connected by the contracted edge. -/
theorem contrGraph_isMinor_of_adj [DecidableEq V]
    (G : SimpleGraph V) {u v : V} (huv : G.Adj u v) :
    contrGraph G u v ≤m G := by
  refine ⟨{
    branchSet := fun x => {w | contrMk u v w = x}
    nonempty := ?_
    disjoint := ?_
    connected := ?_
    adjacent := ?_
  }⟩
  · intro x
    obtain ⟨w, hw⟩ := contrMk_surjective u v x
    exact ⟨w, hw⟩
  · intro x y hxy
    rw [Set.disjoint_left]
    intro w hwx hwy
    exact hxy (hwx.symm.trans hwy)
  · intro x
    rw [connected_iff_exists_forall_reachable]
    obtain ⟨r, hr⟩ := contrMk_surjective u v x
    refine ⟨⟨r, hr⟩, ?_⟩
    rintro ⟨w, hw⟩
    have heq : contrMk u v r = contrMk u v w := hr.trans hw.symm
    rw [contrMk_eq_iff] at heq
    rcases heq with h | ⟨hr, hw⟩ | ⟨hr, hw⟩
    · subst w
      exact Reachable.refl _
    · subst r
      subst w
      exact (show (G.induce {z | contrMk u v z = x}).Adj
        ⟨u, by assumption⟩ ⟨v, by assumption⟩ from huv).reachable
    · subst r
      subst w
      exact (show (G.induce {z | contrMk u v z = x}).Adj
        ⟨v, by assumption⟩ ⟨u, by assumption⟩ from huv.symm).reachable
  · intro x y hxy
    obtain ⟨_hne, a, b, ha, hb, hab⟩ := hxy
    exact ⟨a, ha, b, hb, hab⟩

end EdgeContraction

end SimpleGraph
